{
  "geode": "5.11.2",
  "gd": { "android": "2.2081", "ios": "2.2081" },
  "id": "sillycat.themeui",
  "name": "Theme UI",
  "version": "v1.0.0",
  "developer": "SillyCat",
  "description": "Changes the main menu look with multiple styles.",
  "tags": ["customization", "interface", "joke"],
  "resources": {
    "sprites": ["resources/*.png"]
  },
  "settings": {
    "style": {
      "type": "string",
      "name": "Style",
      "description": "Choose a style (go back to the main menu to apply the change).",
      "default": "Blocky",
      "one-of": ["Default", "Blocky", "Dark", "Neon"]
    }
  }
}
